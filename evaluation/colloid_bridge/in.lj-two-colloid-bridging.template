# NVT LJ fluid in a smooth field generated by two attractive colloids.
# Each colloid has a broad logistic core and a Gaussian attractive shell.

variable T index 1.2
variable box_length index 20.0
variable particle_count index 4600
variable separation index @SEPARATION@
variable colloid_radius index 2.6
variable core_height index 8.0
variable core_width index 0.50
variable shell_radius index 3.4
variable shell_width index 0.80
variable attraction_epsilon index 1.4
variable initial_exclusion_radius index 2.2

variable nequil index 400000
variable nsteps index 4000000
variable sample_every index 10
variable dump_every index 10000
variable grid_spacing index 0.5
variable nsamples equal v_nsteps/v_sample_every
variable placement_seed index @PLACEMENT_SEED@
variable velocity_seed index @VELOCITY_SEED@
variable minimum_initial_separation index 0.60
variable python_executable index python3
variable scripts_dir index ..
variable output_potential_cap index 20.0

variable cx1 equal 0.5*v_box_length-0.5*v_separation
variable cx2 equal 0.5*v_box_length+0.5*v_separation
variable cy equal 0.5*v_box_length
variable cz equal 0.5*v_box_length

units lj
dimension 3
atom_style atomic
boundary p p p

region simbox block 0 ${box_length} 0 ${box_length} 0 ${box_length} units box
create_box 1 simbox

# Keep random initial particles out of the strongly repulsive colloid cores.
region left_out sphere ${cx1} ${cy} ${cz} ${initial_exclusion_radius} side out units box
region right_out sphere ${cx2} ${cy} ${cz} ${initial_exclusion_radius} side out units box
region accessible intersect 3 simbox left_out right_out
create_atoms 1 random ${particle_count} ${placement_seed} accessible overlap ${minimum_initial_separation} maxtry 10000000 units box

mass 1 1.0
group fluid type 1

pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
pair_modify shift yes

neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
# Periodic distances and smooth radial fields for the two colloids.
variable dx1 atom x-v_cx1-lx*round((x-v_cx1)/lx)
variable dy1 atom y-v_cy-ly*round((y-v_cy)/ly)
variable dz1 atom z-v_cz-lz*round((z-v_cz)/lz)
variable r1 atom sqrt(v_dx1*v_dx1+v_dy1*v_dy1+v_dz1*v_dz1+1.0e-20)
variable ecore1 atom exp((v_r1-v_colloid_radius)/v_core_width)
variable Vcore1 atom v_core_height/(1.0+v_ecore1)
variable Acore1 atom v_core_height*v_ecore1/(v_core_width*(1.0+v_ecore1)*(1.0+v_ecore1))
variable G1 atom exp(-(v_r1-v_shell_radius)*(v_r1-v_shell_radius)/(2.0*v_shell_width*v_shell_width))
variable Arad1 atom v_Acore1-v_attraction_epsilon*(v_r1-v_shell_radius)*v_G1/(v_shell_width*v_shell_width)

variable dx2 atom x-v_cx2-lx*round((x-v_cx2)/lx)
variable dy2 atom y-v_cy-ly*round((y-v_cy)/ly)
variable dz2 atom z-v_cz-lz*round((z-v_cz)/lz)
variable r2 atom sqrt(v_dx2*v_dx2+v_dy2*v_dy2+v_dz2*v_dz2+1.0e-20)
variable ecore2 atom exp((v_r2-v_colloid_radius)/v_core_width)
variable Vcore2 atom v_core_height/(1.0+v_ecore2)
variable Acore2 atom v_core_height*v_ecore2/(v_core_width*(1.0+v_ecore2)*(1.0+v_ecore2))
variable G2 atom exp(-(v_r2-v_shell_radius)*(v_r2-v_shell_radius)/(2.0*v_shell_width*v_shell_width))
variable Arad2 atom v_Acore2-v_attraction_epsilon*(v_r2-v_shell_radius)*v_G2/(v_shell_width*v_shell_width)

variable Vext atom v_Vcore1+v_Vcore2-v_attraction_epsilon*(v_G1+v_G2)
variable Fx1 atom v_Arad1*v_dx1/v_r1
variable Fx2 atom v_Arad2*v_dx2/v_r2
variable Fx atom v_Fx1+v_Fx2
variable Fy atom v_Arad1*v_dy1/v_r1+v_Arad2*v_dy2/v_r2
variable Fz atom v_Arad1*v_dz1/v_r1+v_Arad2*v_dz2/v_r2
fix field fluid addforce v_Fx v_Fy v_Fz energy v_Vext
fix_modify field energy yes

# The reaction force on each colloid is minus the force exerted on the fluid.
# For centers at x_1=L/2-D/2 and x_2=L/2+D/2, the generalized force is
# F_D = -(dA_N/dD) = 0.5 * (sum_j Fx1_j - sum_j Fx2_j).
compute colloid1_fx fluid reduce sum v_Fx1
compute colloid2_fx fluid reduce sum v_Fx2
variable F_D equal 0.5*(c_colloid1_fx-c_colloid2_fx)

min_style cg
min_modify dmax 0.05
minimize 1.0e-3 1.0e-2 100 1000

velocity fluid create ${T} ${velocity_seed} mom yes rot no dist gaussian
compute tfluid fluid temp
fix thermostat fluid nvt temp ${T} ${T} 0.5

timestep 0.005
thermo 1000
thermo_style custom step atoms c_tfluid pe ke etotal f_field c_colloid1_fx c_colloid2_fx v_F_D
thermo_modify flush yes

run ${nequil}
reset_timestep 0

dump trajectory fluid custom ${dump_every} trajectory.lammpstrj id type x y z v_Vext
dump_modify trajectory sort id
compute density_bins fluid chunk/atom bin/3d x lower ${grid_spacing} y lower ${grid_spacing} z lower ${grid_spacing} units box compress no
fix density_average fluid ave/chunk ${sample_every} ${nsamples} ${nsteps} density_bins density/number norm sample ave one file density_grid.dat title1 "# Production-averaged density: two-colloid bridging" title2 "# Timestep Number-of-bins" title3 "# Bin x y z mean_count rho"
fix force_samples fluid ave/time ${sample_every} 1 ${sample_every} c_colloid1_fx c_colloid2_fx v_F_D mode scalar ave one file colloid_force_timeseries.dat title1 "# Direct two-colloid reaction-force samples" title2 "# Timestep sum_Fx1_on_fluid sum_Fx2_on_fluid F_D"

run ${nsteps}

undump trajectory
unfix density_average
unfix force_samples
shell ${python_executable} ${scripts_dir}/collect_density_external.py density_grid.dat --application two-colloid-bridging --temperature ${T} --particle-count ${particle_count} --potential-cap ${output_potential_cap} --parameter separation=${separation} --parameter colloid_radius=${colloid_radius} --parameter core_height=${core_height} --parameter core_width=${core_width} --parameter shell_radius=${shell_radius} --parameter shell_width=${shell_width} --parameter attraction_epsilon=${attraction_epsilon}
write_data final.data
